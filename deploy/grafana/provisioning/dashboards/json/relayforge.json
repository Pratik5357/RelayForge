{
  "id": null,
  "title": "RelayForge",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tasks succeeded",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "relayforge_tasks_succeeded_total", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tasks failed",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "relayforge_tasks_failed_total", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue depth",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "relayforge_queue_depth", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lease reclaims",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "relayforge_lease_reclaims_total", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Task duration",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(relayforge_task_duration_seconds_sum[1m]) / rate(relayforge_task_duration_seconds_count[1m])", "refId": "A" }
      ]
    }
  ]
}
