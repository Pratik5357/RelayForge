{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "WorkerPool": {
    "RunInApi": true,
    "Concurrency": 4,
    "PollIntervalMs": 500,
    "ShutdownGraceMs": 5000
  },
  "Reliability": {
    "BaseBackoffMs": 500,
    "MaxBackoffMs": 8000,
    "DefaultMaxAttempts": 4,
    "LeaseDurationMs": 15000,
    "SweepIntervalMs": 1000,
    "DefaultTimeoutMs": 300000
  },
  "Retention": {
    "Days": 7,
    "Cron": "0 3 * * *"
  }
}
