{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "WorkerPool": {
    "Concurrency": 4,
    "PollIntervalMs": 500,
    "ShutdownGraceMs": 5000
  },
  "Reliability": {
    "BaseBackoffMs": 500,
    "MaxBackoffMs": 8000,
    "DefaultMaxAttempts": 4,
    "LeaseDurationMs": 15000,
    "SweepIntervalMs": 1000,
    "DefaultTimeoutMs": 300000
  }
}
