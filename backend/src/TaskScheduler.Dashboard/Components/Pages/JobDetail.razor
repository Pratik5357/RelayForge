@page "/jobs/{Id:guid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using TaskScheduler.Dashboard.Api
@inject IHttpClientFactory HttpFactory
@inject IConfiguration Config
@implements IAsyncDisposable

<PageTitle>Job @Id</PageTitle>

@if (_job is null)
{
    <p>@(string.IsNullOrEmpty(_error) ? "Loading..." : _error)</p>
}
else
{
    <p><a href="/">All jobs</a></p>
    <h1>@_job.Name</h1>
    <p>
        <span class="badge @_job.State.ToLowerInvariant()">@_job.State</span>
        <button @onclick="CancelAsync">Cancel</button>
    </p>

    <h2>DAG</h2>
    <ul class="dag">
        @foreach (var task in _job.Tasks)
        {
            <li>
                <strong>@task.Key</strong>
                <span class="badge @task.State.ToLowerInvariant()">@task.State</span>
                <span>@task.Type attempt @task.AttemptCount/@task.MaxAttempts</span>
                @if (task.DependsOn.Count > 0)
                {
                    <div>depends on: @string.Join(", ", task.DependsOn)</div>
                }
                @if (!string.IsNullOrEmpty(task.LastError))
                {
                    <div class="error">@task.LastError</div>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private JobStatusDto? _job;
    private string? _error;
    private HubConnection? _hub;
    private PeriodicTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        var api = (Config["PublicApiBaseUrl"] ?? Config["ApiBaseUrl"] ?? "http://localhost:5053").TrimEnd('/');
        _hub = new HubConnectionBuilder().WithUrl($"{api}/hubs/jobs").WithAutomaticReconnect().Build();
        _hub.On<object>("jobChanged", async _ =>
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        });
        try
        {
            await _hub.StartAsync();
            await _hub.InvokeAsync("Subscribe", Id);
        }
        catch
        {
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _ = PollAsync();
        }
    }

    private async Task PollAsync()
    {
        if (_timer is null) return;
        while (await _timer.WaitForNextTickAsync())
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var client = HttpFactory.CreateClient("api");
            _job = await client.GetFromJsonAsync<JobStatusDto>($"api/jobs/{Id}");
            _error = _job is null ? "Not found" : null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CancelAsync()
    {
        var client = HttpFactory.CreateClient("api");
        await client.PostAsync($"api/jobs/{Id}/cancel", null);
        await RefreshAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
